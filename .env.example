# Copy to .env and edit. Never commit .env.
# Generate a token with: openssl rand -hex 32
YAOPLM_TOKEN=replace-with-a-long-random-token

# Host path to the OPL folder (the directory that contains CD/, DVD/, ART/, CFG/, ...).
OPL_ROOT=./opl

# UID/GID that own OPL_ROOT. The container runs as this user.
PUID=1000
PGID=1000

# Optional
# OPLMDASH_PORT=7878
# OPLMDASH_IMAGE=ghcr.io/edcm95/oplmdash:dev
# RUST_LOG=info

# Opt-in uploads and the full RPC surface. Leave both false unless you have read
# docs/security/AUDIT_REPORT.md and accept the residual risk.
# YAOPLM_UPLOADS=false
# YAOPLM_RPC_ALLOW_ALL=false
# YAOPLM_MAX_UPLOAD_SIZE=4294967296
